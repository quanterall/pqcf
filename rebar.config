{minimum_otp_vsn, "27"}.
{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.
{pre_hooks, [{compile, "sh native/build.sh"}]}.
{dialyzer, [{warnings, [unmatched_returns, error_handling]}, {plt_extra_apps, [inets]}]}.
{profiles, [{test, [{deps, [{proper, "1.4.0"}, {telemetry, "1.3.0"}]}]}]}.
%% FS 12.6: xref clean. A library's exports are its API, so unused exports are not checked; telemetry is a soft
%% dependency (pq_telemetry calls it only when it runs).
{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used, deprecated_function_calls,
               deprecated_functions]}.
{xref_ignores, [{telemetry, execute, 3}]}.
